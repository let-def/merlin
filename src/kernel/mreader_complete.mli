(** The syntactic completion, generated by LRgrep ([lrgrep completion]):
    the keywords that can come next at the cursor, from the stack of the
    parser before the token at the cursor. *)

(** The keywords that can come at the cursor, each with the construct it
    starts or continues ([match <expr> with <cases>]), the ones that
    reconnect soonest with the next tokens of the input first. *)
val keywords : Mreader_parser.snapshot -> (string * string) list
