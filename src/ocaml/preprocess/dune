(ocamllex lexer_ident lexer_raw)

(library
  (name ocaml_preprocess)
  (public_name merlin-lib.ocaml_preprocess)
  (flags :standard -open Ocaml_parsing -open Ocaml_utils -open Merlin_utils)
  (libraries ocaml_parsing ocaml_utils merlin_utils))

(menhir
 (modules parser_raw)
 (enabled_if (<> %{profile} "release"))
 (mode    (promote (only parser_raw.ml parser_raw.mli)))
 (flags :standard --inspection --table --cmly --lalr))

; The error recovery, generated by LRgrep, and the runtime libraries of
; LRgrep it needs
(rule
  (targets parser_recovery.ml)
  (enabled_if (<> %{profile} "release"))
  (deps    parser_raw.cmly)
  (mode    promote)
  (action
    (run lrgrep -g %{deps} recover -m Parser_raw -o %{targets})))

(rule
 (targets lrgrep_runtime.ml lrgrep_runtime.mli)
 (enabled_if (<> %{profile} "release"))
 (mode promote)
 (action
  (progn
   (copy %{lib:lrgrep.runtime:lrgrep_runtime.ml} lrgrep_runtime.ml)
   (copy %{lib:lrgrep.runtime:lrgrep_runtime.mli} lrgrep_runtime.mli))))

(rule
 (targets lrgrep_recovery.ml lrgrep_recovery.mli)
 (enabled_if (<> %{profile} "release"))
 (mode promote)
 (action
  (progn
   (copy %{lib:lrgrep.recovery:lrgrep_recovery.ml} lrgrep_recovery.ml)
   (copy %{lib:lrgrep.recovery:lrgrep_recovery.mli} lrgrep_recovery.mli))))

(rule
  (targets parser_printer.ml)
  (enabled_if (<> %{profile} "release"))
  (deps    parser_raw.cmly)
  (mode    promote)
  (action
    (with-stdout-to %{targets}
       (run %{exe:./printer/gen_printer.exe} %{deps}))))

(rule
 (targets menhirLib.ml menhirLib.mli)
 (mode promote)
 (action (run menhir --dump-menhirLib .)))
