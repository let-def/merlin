(** Runtime support for the syntactic completion generated by
    [lrgrep completion].

    The generated module provides the tables of a grammar (see {!TABLES})
    and instantiates {!Make} with them and the parser, which must be
    generated by Menhir with [--table --inspection].

    The completions of a parser state are the terminals that can come next,
    with the constructions they continue. They are computed by an automaton
    that reads the stack from the top and simulates the reductions that the
    next token can trigger: a cell is a pending reduction, which follows the
    goto transition of the state of a frame, reaches a clause (a set of
    items) and starts new cells, at this frame or below.

    The completions can be ranked by how soon they reconnect with the next
    tokens of the input, with the sets of states that can read the n-grams
    of terminals (bigrams, or trigrams with [lrgrep completion --trigrams]). *)

(** {1 Parsers and tables} *)

(** The parser, generated by Menhir with [--table --inspection]. *)
module type PARSER = sig
  type token
  module MenhirInterpreter : MenhirLib.IncrementalEngine.EVERYTHING
    with type token = token
  module Tables : MenhirLib.TableFormat.TABLES
    with type token = token
end

(** The automaton of pending reductions. The transitions of the states
    come from the tables of the parser. *)
type automaton = {
  links : Lrgrep_runtime.Sparse_table.t;
  (** The action of applying a cell (a row) to a state reached by its goto
      transition (a column), for the actions other than the default one of
      the cell *)
  cell_nonterminal : int -> int;
  (** The non-terminal of a cell, shifted by one (0 for the initial cell,
      which applies to the state itself) *)
  cell_row : int -> int;
  (** The row of a cell in [links] *)
  cell_default : int -> int;
  (** The default action of a cell, shifted by one (0 for none) *)
  initial : int;
  (** The cell of the actions of the state at the top of the stack *)
  action_clause : int -> int;
  (** The clause reached by an action, shifted by one (0 for none) *)
  action_spawns : int -> int;
  (** The cells started by action [a] are the spawns from
      [action_spawns a] to [action_spawns (a + 1) - 1] *)
  spawn_cell : int -> int;
  spawn_depth : int -> int;
  (** A spawn starts a cell at a depth relative to the current frame *)
}

(** The tables generated by [lrgrep completion]. The symbols are numbered
    terminals first, then non-terminals; the states, terminals and
    productions as in Menhir. *)
module type TABLES = sig
  (** The symbols of the grammar before inlining, and the segments of the
      continuations, as constant constructors: [symbol_of_int] and
      [int_of_symbol] convert from and to their numbers (likewise for the
      segments). The terminals come first, numbered as in Menhir. A segment
      is the rest of a branch from a position, numbered as the position in
      [branch_producers]. *)
  type symbol
  type segment
  val symbol_of_int : int -> symbol
  val int_of_symbol : symbol -> int
  val segment_of_int : int -> segment
  val int_of_segment : segment -> int

  val automaton : automaton

  (** A group is a state (2 bytes), the length of its mask (1 byte) and a
      mask of the suggestions of the state reached. A clause is a range of
      groups. *)
  val groups : string
  val group_offsets : int -> int
  val clause_groups : int -> int
  val clause_offsets : int -> int

  (** The productions, as symbols: the left-hand side, then the right-hand
      side, the symbols below [terminals] being terminals. *)
  val terminals : int
  val productions : int -> int
  val production_offsets : int -> int

  (** The derivation trees of the non-terminals: the productions reachable
      by expanding the leftmost symbol, each with its parent (its index in
      the tree plus one, 0 for none). *)
  val tree_production : int -> int
  val tree_parent : int -> int
  val tree_offsets : int -> int

  (** The surface grammar, before inlining: the names of the symbols, the
      annotations ([surface_omitted.[n] = '1'] if [n] is omitted,
      [surface_annotated.[n] = '1'] if a directive applies to it, and how it
      is printed), the rule and the producers of the branches, and for
      each symbol of the right-hand side of a production (indexed like
      [productions]) its path of branches and producer indices, the
      innermost last. *)
  val surface_names : string array
  val surface_omitted : string
  val surface_annotated : string
  val surface_display : string array
  val branch_count : int
  val branch_rule : int -> int
  val branch_producers : int -> int
  val branch_offsets : int -> int
  val path_branch : int -> int
  val path_index : int -> int
  val path_offsets : int -> int

  (** The n-grams of terminals and the sets of states that can read them,
      [ngram_length] being 2 (bigrams) or 3 (trigrams). See [Trigrams] in
      the sources of lrgrep for the encoding. *)
  val ngram_length : int
  val ngram_classes : int
  val ngram_sets : int
  val ngram_class : int -> int
  val ngram_set_base : int -> int
  val ngram_set_offsets : int -> int
  val ngram_set_delta : string
  val ngram_pairs : Lrgrep_runtime.Sparse_table.t
  val ngram_pair_row : int -> int
  val trigram_rows : int
  val trigram_row_offsets : int -> int
  val trigram_keysets : int
  val trigram_groups : int -> int
  val trigram_keys_size : int
  val trigram_keys : string
end

(** {1 Completions} *)

(** A suggestion: the [terminal] can be shifted in [state], reached by
    following the goto transition of the frame at [depth] in the stack (0
    for the top of the stack). The [derivation] starts with a kernel item of
    [state] and goes down, through items at position 0, to an item whose
    next symbol is [terminal]. The numbers are Menhir's: [state] as
    [current_state_number], [terminal] as [Tables.token2terminal], the
    items are pairs of a production, as [production_index], and a
    position. {!Make} gives their continuations in the symbols of the
    grammar before inlining. *)
type suggestion = {
  depth : int;
  state : int;
  terminal : int;
  derivation : (int * int) list;
}

(** A printed continuation: symbols, and optional segments *)
type piece =
  | Symbol of string
  | Optional of piece list

module Make (P : PARSER) (T : TABLES) : sig
  type nonrec suggestion = suggestion = {
    depth : int;
    state : int;
    terminal : int;
    derivation : (int * int) list;
  }

  type nonrec piece = piece =
    | Symbol of string
    | Optional of piece list

  (** The suggestions for the next token, from the top of the stack
      downwards. A suggestion reached at several depths is listed once, at
      the smallest one. *)
  val complete : 'a P.MenhirInterpreter.env -> suggestion list

  (** The suggestions of [complete env] that do not come from omitted
      symbols, grouped by their printed continuation: each continuation
      with its suggestions, by depth then by length of the derivation. The
      continuations are sorted deepest first, by the smallest depth of
      their suggestions: the constructs open deeper in the stack come
      before the ones starting at the top. At the same depth, the
      continuations of the productions with more symbols already read come
      first (the [then] of [if e] before the operators after [e]), then by
      their first appearance in [complete env]. Two continuations reached
      at the same depth, one being the other with a contiguous segment
      inserted ([a b] and [a x b]), are merged as [a \[x\] b]. *)
  val complete_by_continuation :
    'a P.MenhirInterpreter.env -> (piece list * suggestion list) list

  (** The groups of [complete_by_continuation env], those that reconnect
      soonest with [suffix] first: [suffix] is the next tokens of the input
      (about 20), and the groups are sorted by the smallest {!distance} of
      their suggestions. *)
  val rank :
    suffix:P.token list -> 'a P.MenhirInterpreter.env ->
    (piece list * suggestion list) list

  (** {2 Suggestions in the surface grammar}

      The continuation of a suggestion is written with the symbols of the
      grammar before inlining ([%inline] rules, instances of parameterized
      rules), the constructors of [T.symbol]: its terminal and the rest of
      its branch, then the rest of each enclosing branch, after the symbol
      at its dot, up to the kernel item. It is a sequence of segments, the
      constructors of [T.segment], each the rest of a branch. *)

  (** The continuation of a suggestion, as segments *)
  val segments : suggestion -> T.segment list

  (** The continuation of a suggestion, as symbols: the symbols of its
      segments *)
  val symbols : suggestion -> T.symbol list

  (** The symbols of a segment *)
  val segment_symbols : T.segment -> T.symbol array

  (** The branch of a segment: its rule, and its producers with the
      position where the segment starts *)
  val segment_rule : T.segment -> T.symbol
  val segment_item : T.segment -> T.symbol array * int

  (** The name of a symbol in the grammar ([list(attribute)]), how it is
      printed with the annotations, and whether it is omitted *)
  val symbol_name : T.symbol -> string
  val symbol_display : T.symbol -> string
  val symbol_omitted : T.symbol -> bool

  (** How a symbol is printed if a directive of the annotations applies to
      it, [None] otherwise (it is then printed as the alias of a terminal or
      its name): [Option.value ~default:(symbol_name s) (symbol_annotation s)]
      prints the symbols without the aliases *)
  val symbol_annotation : T.symbol -> string option

  (** A segment as printed: the symbols that are not omitted, printed by
      [symbol] ({!symbol_display} by default) *)
  val segment_display : ?symbol:(T.symbol -> string) -> T.segment -> string list

  (** The terminals, numbered as in Menhir *)
  val is_terminal : T.symbol -> bool
  val terminal_symbol : int -> T.symbol

  (** The names of the symbols of the continuation *)
  val surface_continuation : suggestion -> string list

  (** The continuation as printed: the surface symbols that are not
      omitted, with their printed text. *)
  val display_continuation : suggestion -> string list

  (** Whether the terminal of a suggestion comes from an omitted symbol *)
  val is_omitted : suggestion -> bool

  (** {2 Transitions and n-grams}

      States and terminals are numbered as in Menhir. *)

  (** The number of terminals *)
  val terminals : int

  (** The target of the transition of a state on a symbol (terminals first,
      then non-terminals), if any. *)
  val transition : int -> int -> int option

  (** The states visited by the continuation of a suggestion, in order *)
  val visited : suggestion -> int list

  (** The set of the states that can read the terminals [t0 t1], if any *)
  val bigram : int -> int -> int option

  (** The set of the states that can read the terminals [t0 t1 t2], if any.
      It is the set of [t0 t1] for the tables without trigrams, and for the
      trigrams whose set is not stored. *)
  val trigram : int -> int -> int -> int option

  (** Whether a state is in a set of [bigram] or [trigram] *)
  val in_set : int -> int -> bool

  (** [distance suffix s] is how far the continuation of [s] is from
      reconnecting with [suffix], terminals of the next tokens: the
      smallest [i + j] such that the state reached after [j] symbols of the
      continuation can read the n-gram at position [i] of [suffix],
      [max_int] if there is none. *)
  val distance : int list -> suggestion -> int
end
