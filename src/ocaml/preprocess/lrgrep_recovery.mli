(** Runtime support for the error recovery generated by [lrgrep recover].

    The generated module provides the tables of the strategies of a grammar
    (see {!TABLES}) and instantiates {!Make} with them and the parser, which
    must be generated by Menhir with [--table --inspection].

    A recovery starts from the stack of a parser that failed, and receives
    the following tokens one by one (see {!Make.recover}); the caller drives
    the parser. It is guided by the layout of the input:

    - a policy, a fold over the tokens of the recovery, tells at each token
      how many frames of the stack may still be open when the token is
      shifted (the others belong to constructs the token closes): the
      frames policy from the positions of the frames only, the bracket
      policies from spans computed on the whole input;

    - a guide can advise, before recovering, a cut: if the parser accepted
      tokens in a construct that the layout had closed (an unfinished
      definition absorbing the next one), the stack is popped down to the
      first frame out of place, and the tokens are given again from where
      it starts;

    - the candidates of the recovery are the configurations reached by the
      strategies, by increasing cost (a Dijkstra search). At each token, the
      cheapest candidate that accepts the next tokens and keeps no more
      frames than the policy allows resumes the parse; the cheapest
      accepting one if none does. If no candidate accepts the token, it is
      skipped.

    The search is simulated on the states of the stack: a candidate builds
    the real stack of the parser, running the semantic actions, only when
    it is chosen. *)

(** {1 Parsers and tables} *)

(** The parser, generated by Menhir with [--table --inspection]. *)
module type PARSER = sig
  type token
  module MenhirInterpreter : MenhirLib.IncrementalEngine.EVERYTHING
    with type token = token
  module Tables : MenhirLib.TableFormat.TABLES
    with type token = token
end

(** The tables generated by [lrgrep recover]. The symbols are numbered
    terminals first, then non-terminals. *)
module type TABLES = sig
  type 'a env

  (** Shift a symbol with its placeholder value, at a position. *)
  val shift : int -> Lexing.position -> 'a env -> 'a env

  (** The number of terminals. *)
  val terminal_count : int

  (** The length of the right-hand side of a production. *)
  val production_length : int -> int

  (** The tactics: sequences of actions [4 * x + kind], to reduce
      production [x] (kind 0), shift symbol [x] (1), apply tactic [x] (2)
      or accept (3). The actions of tactic [t] are the ones from
      [tactic_offsets t] to [tactic_offsets (t + 1) - 1]. *)
  val tactic_offsets : int -> int
  val tactic_actions : int -> int

  (** The tactic completing the start item of an entrypoint, plus one (0
      for none). *)
  val initial_tactic : int -> int

  (** The strategies of a transition: the state at the top (a row of
      [strategy_lists], through [strategy_row]) and the one below (a
      column) map to a list, a range of strategies. *)
  val strategy_lists : Lrgrep_runtime.Sparse_table.t
  val strategy_row : int -> int
  val strategy_offsets : int -> int
  val strategy_tactic : int -> int
  val strategy_cost : int -> int
  val strategy_total : int -> int

  (** The item completed by a strategy: the non-terminal of its production
      (plus one, 0 for a start production), and its position. *)
  val strategy_lhs : int -> int
  val strategy_pos : int -> int

  (** Merlin's decisions: the depth of a state, its default tactic (plus
      one, 0 for none), and the tactics by state at that depth
      ([merlin_states] standing for the bottom of the stack). *)
  val merlin_depth : int -> int
  val merlin_default : int -> int
  val merlin_states : int
  val merlin_select : Lrgrep_runtime.Sparse_table.t
  val merlin_row : int -> int
end

(** {1 Bracket policies}

    They do not depend on the parser, only on its tokens. *)

(** The tokens given to a bracket policy: start position, token, end
    position. *)
type 'token triple = Lexing.position * 'token * Lexing.position

(** A bracket policy: the numbers of brackets opened and closed before
    each token, the closed ones first. It should observe as few tokens as
    needed to produce each pair. *)
type 'token bracket_policy = 'token triple Seq.t -> (int * int) Seq.t

(** The indentation policy: a bracket opens at each line more indented
    than the enclosing ones, and the brackets of the lines more indented
    than a line close before it; the last token closes all of them. *)
val indentation : 'token bracket_policy

(** The tokens of a language, for the lexical policy: its delimiters, its
    items (the definitions of a module, the statements of a block) and its
    local bindings, which do not depend on the layout. *)
type 'token lexical = {
  delimiters : 'token option -> 'token -> [`Open of int | `Close of int] list;
  (** The roles of a token, given the previous one: the kinds of pairs it
      closes, then opens. *)
  starts_item : 'token -> 'token -> bool;
  (** Whether a token, given the previous one, starts an item: when the
      previous token cannot be followed by it inside an item. *)
  binding : 'token -> [`Let | `In | `Equal | `Other];
  (** The tokens of the local bindings [let ... = ... in ...]: a binding
      waiting for its [in] at the end of an item tells an unfinished
      definition from a missing [in]. [`Other] for the languages without
      them. *)
}

(** The lexical policy, which does not look at the layout (columns and
    lines), for minified or garbled inputs too, with the tokens of the
    language described by [l].

    - The delimiters are matched over the whole input, with the fewest left
      unmatched: the adjacent matching delimiters first (which keeps a
      minimal matching), in one pass; then a dynamic programming, cubic, on
      the delimiters that remain, a few per error ([limit] of them at most,
      400; a greedy matching above). The matched pairs are spans, the
      unmatched delimiters are not.
    - With [items] (the default), each item is a span too, from its start to
      the next item start in the same innermost pair. A binding waiting for
      its [in] at the end of an item comes either from a missing [in] or
      from an unfinished definition, followed by a definition read as a
      local binding: if the binding that starts the next item gets its [in]
      in this next item, an [in] is missing, and it does not start an item;
      otherwise, the last binding waiting after a [=], with a [=] of its
      own, starts an item. *)
val lexical : ?items:bool -> ?limit:int -> 'token lexical -> 'token bracket_policy

(** {1 The recovery} *)

module Make (P : PARSER) (T : TABLES with type 'a env := 'a P.MenhirInterpreter.env) : sig

  (** {2 Strategies and tactics} *)

  (** A strategy: a tactic, its cost, the total cost of exiting the context
      through it, and the item it completes: the non-terminal produced
      ([-1] for a start production) and the position of the item, the
      number of frames it pops before following the goto transition of the
      non-terminal. *)
  type strategy = {
    tactic : int;
    cost : int;
    total : int;
    lhs : int;
    pos : int;
  }

  (** The strategies of a stack whose top state is [top], and [below] the
      one below it, by increasing total cost. *)
  val strategies_of_states : int -> int option -> strategy list

  (** The strategies of a stack, by increasing total cost. *)
  val strategies : 'a P.MenhirInterpreter.env -> strategy list

  (** The position of placeholder values: the end of the top of the
      stack. *)
  val position : 'a P.MenhirInterpreter.env -> Lexing.position

  (** Apply a tactic to a stack: [`Env env'], or [`Accept env'] when it
      produces the start symbol. The semantic actions can raise
      exceptions. *)
  val apply : int -> 'a P.MenhirInterpreter.env ->
    [`Env of 'a P.MenhirInterpreter.env | `Accept of 'a P.MenhirInterpreter.env]

  (** Apply a tactic step by step, like Merlin: [`Steps envs], the
      configurations after each of its actions, a final call being
      expanded (it continues the item being completed); [`Accept env] if it
      accepts; [`Abort] if a semantic action fails. *)
  val apply_steps : int -> 'a P.MenhirInterpreter.env ->
    [`Steps of 'a P.MenhirInterpreter.env list | `Accept of 'a P.MenhirInterpreter.env | `Abort]

  (** The value of a parser that accepted: the semantic value at the top of
      its stack, which is the start symbol. *)
  val accepted : 'a P.MenhirInterpreter.env -> 'a

  (** Merlin's decision for a stack: the tactic completing an item of its
      top state, chosen by the state at the depth of this state. *)
  val merlin_decision : 'a P.MenhirInterpreter.env -> int option

  (** {2 The input} *)

  (** A token, as offered to the parser: the token and its positions. *)
  type token = P.token * Lexing.position * Lexing.position

  (** A sequence of tokens, read as needed and kept: a recovery can resume
      from an earlier token. *)
  type input

  val input : token Seq.t -> input

  (** {2 Bracket policies and spans} *)

  type nonrec triple = P.token triple
  type nonrec bracket_policy = P.token bracket_policy

  (** {!Lrgrep_recovery.indentation} and {!Lrgrep_recovery.lexical}, for
      the tokens of the parser. *)
  val indentation : bracket_policy
  val lexical : ?items:bool -> ?limit:int -> P.token lexical -> bracket_policy

  (** The spans of a bracket policy on an input, computed as needed. *)
  type spans

  val spans : bracket_policy -> input -> spans

  (** Compute the spans up to a token. *)
  val extend : spans -> int -> unit

  (** The number of spans computed. *)
  val span_count : spans -> int

  (** {2 Recovering}

      A recovery starts from the stack of a parser that failed, before it
      read the token it rejected, and receives this token and the following
      ones, one by one. A policy, a fold over these tokens, tells which
      frames of the stack each token closes; a guide tells how far to cut
      the stack before recovering, as an advice. *)

  (** A policy: a fold over the tokens given to a recovery, which tells, at
      each token, the number of frames of the stack of the recovery, from
      the bottom, that may still be open when this token is shifted: the
      candidates keeping more frames are tried only if none keeps fewer. *)
  type 's policy = {
    state : 's;
    feed : 's -> token -> 's * int;
  }

  (** A guide: the cut it advises when the parser fails, the stack popped
      down to the first frame out of place and the position from which the
      tokens should be given again (the first token starting at or after
      it), and the policy of a recovery from a stack. The cut is an advice:
      a completion does not cut, and it should not be applied twice at the
      same place. *)
  type 's guide = {
    cut : 'a. 'a P.MenhirInterpreter.env -> ('a P.MenhirInterpreter.env * Lexing.position) option;
    start : 'a. 'a P.MenhirInterpreter.env -> 's policy;
  }

  (** The frames policy, which only looks at the stack: the indentation of
      a frame is its column if it starts a line, the indentation of the
      frame below otherwise. A token starting a line at column [t] closes
      the frames of a run of more than [1 + slack] consecutive frames more
      indented than [t] (they should have been reduced to one); the guide
      cuts at the first frame starting a line that would close frames
      below it. [slack] defaults to 0. *)
  type frames
  val frames : ?slack:int -> unit -> frames guide

  (** A bracket policy, from the tokens of the whole input (read as
      needed): a frame cannot stay open in a span closed before a token if
      the span holds more than [1 + slack] frames, or if it starts inside a
      closed span and ends after it; the guide cuts at the first frame
      violating the spans. *)
  val brackets : ?slack:int -> bracket_policy -> token Seq.t -> int guide

  (** Statistics of the recovery. *)
  type stats = {
    mutable recoveries : int; (** the errors recovered from *)
    mutable repairs : int; (** the stacks cut *)
    mutable skipped : int; (** the tokens skipped *)
    mutable expansions : int; (** the configurations expanded *)
    mutable mismatches : int; (** with [verify], the differences between
                                  the simulation and the parser *)
  }

  val stats : unit -> stats

  (** A recovery in progress. It is consumed by feeding it. *)
  type 'a recovery

  (** Start a recovery from [env], the stack of a parser in the state
      [InputNeeded] before it read the token it rejected, with a policy
      started from this stack (or from a stack cut by a guide):

      - [limit] (100): the number of configurations expanded by a search;
      - [lookahead] (3): the number of tokens a candidate must accept;
      - [steps] (true): the configurations inside the cheapest strategy of
        each configuration are candidates too;
      - [verify] (false): check the simulation against the parser, counting
        the differences in [stats.mismatches];
      - [stats]: the statistics to update;
      - [log]: a function receiving a description of each decision. *)
  val recover :
    ?limit:int -> ?lookahead:int -> ?steps:bool -> ?verify:bool ->
    ?stats:stats -> ?log:(string -> unit) ->
    's policy -> 'a P.MenhirInterpreter.env -> 'a recovery

  (** Feed the next token to a recovery, from the token the parser
      rejected (or, after a cut, from the first token starting at the
      position of the cut). A candidate is chosen when [lookahead] tokens
      are known: [`Resume env], the parser after the candidate and the
      tokens fed but not yet consumed, needing the next token;
      [`Accept v] if it accepts; [`Recovering] while it waits for more
      tokens or skipped the first one. *)
  val feed : 'a recovery -> token ->
    [`Recovering | `Resume of 'a P.MenhirInterpreter.env | `Accept of 'a]

  (** The end of the input: the value of the cheapest completion, after
      choosing a candidate for the tokens fed but not yet consumed. *)
  val finish : 'a recovery -> 'a option

  (** The parser after choosing a candidate for the tokens fed, as if the
      input ended after them, without completing it: the stack at a cursor
      inside the tokens of a recovery, for a completion. The recovery is
      not changed. [None] if the candidate accepts. *)
  val choose : 'a recovery -> 'a P.MenhirInterpreter.env option

  (** {2 Parsing with recovery} *)

  (** Parse from the checkpoint [entry], recovering from the errors with a
      guide, made from the tokens of the input (read as needed, and kept):
      [None] if the parser does not accept (the input is empty, or the
      parser cannot reach its end). [frames] does not look at them:
      [parse (fun _ -> frames ())], [parse (brackets indentation)].

      - [limit], [lookahead], [steps], [verify], [stats], [log]: see
        {!recover};
      - [repair] (true): apply the cuts advised by the guide, each one
        starting after the previous one (for the parse to progress);
      - [on_error]: a function called at each syntax error, before the
        recovery, with the stack of the parser before it read the token it
        rejected, and this token: the arguments of the rules generated by
        [lrgrep compile], to report the errors (once for each token, a
        repair resuming from an earlier token can meet an error again);
      - [on_exception]: if given, called instead of [on_error] when the
        error comes from a semantic action that raises, with the exception
        (the exceptions raised by the semantic actions of the recovery itself
        are not reported).

      The sequence must end after the end of input. *)
  val parse :
    ?limit:int -> ?lookahead:int -> ?steps:bool -> ?verify:bool -> ?repair:bool ->
    ?stats:stats -> ?log:(string -> unit) -> ?on_error:('a P.MenhirInterpreter.env -> token -> unit) ->
    ?on_exception:('a P.MenhirInterpreter.env -> token -> exn -> unit) ->
    (token Seq.t -> 's guide) -> 'a P.MenhirInterpreter.checkpoint -> token Seq.t -> 'a option

  (** The tokens of a supplier, up to the first one that is the end of
      input, by [is_eof]. *)
  val tokens_of_supplier : is_eof:(P.token -> bool) -> (unit -> token) -> token Seq.t

  (** {!parse} for a supplier of tokens, as [MenhirInterpreter.loop]. *)
  val parse_supplier :
    ?limit:int -> ?lookahead:int -> ?steps:bool -> ?verify:bool -> ?repair:bool ->
    ?stats:stats -> ?log:(string -> unit) -> ?on_error:('a P.MenhirInterpreter.env -> token -> unit) ->
    ?on_exception:('a P.MenhirInterpreter.env -> token -> exn -> unit) ->
    is_eof:(P.token -> bool) ->
    (token Seq.t -> 's guide) -> 'a P.MenhirInterpreter.checkpoint -> (unit -> token) -> 'a option

  (** {!parse} for a lexer and its buffer. *)
  val parse_lexbuf :
    ?limit:int -> ?lookahead:int -> ?steps:bool -> ?verify:bool -> ?repair:bool ->
    ?stats:stats -> ?log:(string -> unit) -> ?on_error:('a P.MenhirInterpreter.env -> token -> unit) ->
    ?on_exception:('a P.MenhirInterpreter.env -> token -> exn -> unit) ->
    is_eof:(P.token -> bool) ->
    (token Seq.t -> 's guide) -> 'a P.MenhirInterpreter.checkpoint ->
    (Lexing.lexbuf -> P.token) -> Lexing.lexbuf -> 'a option
end
