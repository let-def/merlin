# Annotations of the grammar for the syntactic completion (lrgrep
# completion -a): `symbol: directives`, with `omit` (leave out of the
# suggestions) or "text" (how to print it).

# Attributes and extension points are optional, they are not suggested.
ext_attributes: omit
ext: omit
attributes: omit
post_item_attributes: omit
list(attribute): omit
# The end of the input is not a completion
EOF: omit

# Categories
seq_expr: "<expr>"
expr: "<expr>"
fun_expr: "<expr>"
simple_expr: "<expr>"
labeled_simple_expr: "<argument>"
pattern: "<pattern>"
pattern_semi_list: "<pattern> ';' ..."
simple_pattern: "<pattern>"
match_cases: "<cases>"
core_type: "<type>"
atomic_type: "<type>"
module_expr: "<module>"
module_type: "<module type>"
mod_longident: "<Module>"
val_ident: "<ident>"
fun_params: "<params>"
fun_body: "<expr>"
list(structure_element): "<structure>"
structure: "<structure>"
let_binding_body: "<binding>"
local_structure_item: "<binding>"
rec_flag: "[rec]"
direction_flag: "to"
class_longident: "<class>"
class_structure: "<class body>"
raw_string: "<string>"
generalized_constructor_arguments: omit
nonrec_flag: "[nonrec]"
no_nonrec_flag: "[nonrec]"
private_flag: "[private]"
virtual_flag: "[virtual]"
override_flag: "[!]"
mutable_flag: "[mutable]"
type_parameters: "[<params>]"
formal_class_parameters: "[<params>]"
module_name: "<Module>"
module_binding_body: "= <module>"
possibly_poly: identity
nonempty_list(raw_string): "<string> ..."
constr_ident: "<Constructor>"
constr_longident: "<Constructor>"
pattern_gen: "<pattern>"
class_fun_binding: "= <class expr>"
class_expr: "<class expr>"
class_type: "<class type>"
bar_llist: "<constructors>"
type_longident: "<type>"
type_kind: "[= <definition>]"
constraints: "[constraint ...]"
LIDENT: "<ident>"
UIDENT: "<Ident>"

# Parameterized rules: locations are transparent, options are optional
mkrhs: identity
option: optional
ioption: optional
preceded: expand
terminated: expand
type_constraint: "':' <type>"

# Longer names of the grammar
label: "<label>"
label_longident: "<ident>"
mod_ext_longident: "<Module>"
mty_longident: "<module type>"
ident: "<ident>"
val_longident: "<ident>"
let_ident: "<ident>"
clty_longident: "<class type>"
core_type_no_attr: "<type>"
poly_type_no_attr: "<type>"
possibly_poly_type: "<type>"
function_type: "<type>"
tuple_type: "<type>"
constructor_arguments: "<type>"
package_type_: "<module type>"
package_type: "<module type>"
class_signature: "<class type>"
typevar: "'<ident>"
typevar_list: "'<ident> ..."
lident_list: "<ident> ..."
type_subst_kind: ":= <type>"
with_type_binder: "="
with_constraint: "<constraint>"
separated_nonempty_llist(AND,with_constraint): "<constraints>"
functor_args: "<params>"
functor_arg: "<param>"
signature: "<signature>"
module_declaration_body: ": <module type>"
module_expr_alias: "<Module>"
constrain: "<type> = <type>"
opt_ampersand: "[&]"
amper_type_list: "<type> ..."
pattern_no_exn: "<pattern>"
expr_semi_list: "<expr> ; ..."
label_declarations: "<fields>"
inline_private_flag: "[private]"

# The terminals, printed as their [@symbol] attribute, quoted
AMPERAMPER: "'&&'"
AMPERSAND: "'&'"
AND: "'and'"
AS: "'as'"
ASSERT: "'assert'"
BACKQUOTE: "'`'"
BANG: "'!'"
BAR: "'|'"
BARBAR: "'||'"
BARRBRACKET: "'|]'"
BEGIN: "'begin'"
CLASS: "'class'"
COLON: "':'"
COLONCOLON: "'::'"
COLONEQUAL: "':='"
COLONGREATER: "':>'"
COMMA: "','"
CONSTRAINT: "'constraint'"
DO: "'do'"
DONE: "'done'"
DOT: "'.'"
DOTDOT: "'..'"
DOWNTO: "'downto'"
EFFECT: "'effect'"
ELSE: "'else'"
END: "'end'"
EQUAL: "'='"
EXCEPTION: "'exception'"
EXTERNAL: "'external'"
FALSE: "'false'"
FOR: "'for'"
FUN: "'fun'"
FUNCTION: "'function'"
FUNCTOR: "'functor'"
GREATER: "'>'"
GREATERRBRACE: "'>}'"
GREATERRBRACKET: "'>]'"
IF: "'if'"
IN: "'in'"
INCLUDE: "'include'"
INHERIT: "'inherit'"
INITIALIZER: "'initializer'"
LAZY: "'lazy'"
LBRACE: "'{'"
LBRACELESS: "'{<'"
LBRACKET: "'['"
LBRACKETBAR: "'[|'"
LBRACKETLESS: "'[<'"
LBRACKETGREATER: "'[>'"
LBRACKETPERCENT: "'[%'"
LBRACKETPERCENTPERCENT: "'[%%'"
LESS: "'<'"
LESSMINUS: "'<-'"
LET: "'let'"
LPAREN: "'('"  # [@symbol ")"] in the grammar
LBRACKETAT: "'[@'"
LBRACKETATAT: "'[@@'"
LBRACKETATATAT: "'[@@@'"
MATCH: "'match'"
METHOD: "'method'"
MINUS: "'-'"
MINUSDOT: "'-.'"
MINUSGREATER: "'->'"
MODULE: "'module'"
MUTABLE: "'mutable'"
NEW: "'new'"
NONREC: "'nonrec'"
OBJECT: "'object'"
OF: "'of'"
OPEN: "'open'"
OR: "'or'"
PERCENT: "'%'"
PLUS: "'+'"
PLUSDOT: "'+.'"
PLUSEQ: "'+='"
PRIVATE: "'private'"
QUESTION: "'?'"
QUOTE: "'''"
RBRACE: "'}'"
RBRACKET: "']'"
REC: "'rec'"
RPAREN: "')'"
SEMI: "';'"
SEMISEMI: "';;'"
HASH: "'#'"
SIG: "'sig'"
STAR: "'*'"
STRUCT: "'struct'"
THEN: "'then'"
TILDE: "'~'"
TO: "'to'"
TRUE: "'true'"
TRY: "'try'"
TYPE: "'type'"
UNDERSCORE: "'_'"
VAL: "'val'"
VIRTUAL: "'virtual'"
WHEN: "'when'"
WHILE: "'while'"
WITH: "'with'"
METAOCAML_ESCAPE: "'.~'"
METAOCAML_BRACKET_OPEN: "'.<'"
METAOCAML_BRACKET_CLOSE: "'>.'"
